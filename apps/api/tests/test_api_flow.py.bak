    assert payload["latest_dataset_status"] == "analyzed"
    assert payload["decisions"]["observed_after_decision"] == 0
    assert payload["no_show"]["measured_outcomes"] == 0


def test_executive_summary_exposes_period_comparison_after_second_dataset() -> None:
    org_id = create_tenant("Executive Temporal Diagnosticos")
    base = Path("datasets/csv-sample")

    def bundle(*, equipment_bytes: bytes):
        return {
            "equipment": ("equipment.csv", equipment_bytes, "text/csv"),
            "availability": ("availability.csv", (base / "availability.csv").read_bytes(), "text/csv"),
            "appointments": ("appointments.csv", (base / "appointments.csv").read_bytes(), "text/csv"),
            "executions": ("executions.csv", (base / "executions.csv").read_bytes(), "text/csv"),
        }

    original_equipment = (base / "equipment.csv").read_bytes()
    for files in (
        bundle(equipment_bytes=original_equipment),
        bundle(equipment_bytes=original_equipment.replace(b"RM-02", b"RM-02 ", 1)),
    ):
        uploaded = client.post(
            "/v1/datasets/csv-bundle",
            headers=tenant_headers(org_id, mutate=True),
            files=files,
        )
        assert uploaded.status_code == 201, uploaded.text
        dataset_id = uploaded.json()["dataset"]["id"]
        analyzed = client.post(
            f"/v1/datasets/{dataset_id}/analyze",
            headers=tenant_headers(org_id, mutate=True),
        )
        assert analyzed.status_code == 200, analyzed.text

    summary = client.get("/v1/executive/summary", headers=tenant_headers(org_id))
    assert summary.status_code == 200, summary.text
    payload = summary.json()
    assert payload["previous_period_at"] is not None
    assert payload["comparisons"]
    assert payload["comparisons"][0]["key"] == "operational_potential"
    assert {item["trend"] for item in payload["comparisons"]} <= {
        "improving",
        "worsening",
        "stable",
        "insufficient_data",
    }
    assert "decision_rows" in payload
