    assert accepted.status_code == 200, accepted.text

    executed = client.put(
        f"/v1/ml/no-show/predictions/{pid}/intervention",
        headers=tenant_headers(org_id, mutate=True),
        json={"channel": "whatsapp", "contact_result": "confirmed"},
