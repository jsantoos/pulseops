def test_no_show_intervention_is_idempotently_updated_and_tenant_isolated() -> None:
    org_a = create_tenant("Intervention Tenant A")
    org_b = create_tenant("Intervention Tenant B")
    predictions = _train_no_show_for_tenant(org_a)
    actionable = next(item for item in predictions if item["action_recommended"])

    accepted = client.post(
        f"/v1/ml/no-show/predictions/{actionable['id']}/decision",
        headers=tenant_headers(org_a, mutate=True),
        json={"decision": "accepted"},
    )
    assert accepted.status_code == 200, accepted.text

    first = client.put(
        f"/v1/ml/no-show/predictions/{actionable['id']}/intervention",
        headers=tenant_headers(org_a, mutate=True),
        json={"channel": "whatsapp", "contact_result": "no_response", "note": "Primeira tentativa"},
    )
    assert first.status_code == 200, first.text
    first_id = first.json()["id"]

    second = client.put(
        f"/v1/ml/no-show/predictions/{actionable['id']}/intervention",
        headers=tenant_headers(org_a, mutate=True),
        json={"channel": "phone", "contact_result": "confirmed", "note": "Confirmou por telefone"},
    )
    assert second.status_code == 200, second.text
    assert second.json()["id"] == first_id
    assert second.json()["channel"] == "phone"
    assert second.json()["contact_result"] == "confirmed"

    forbidden = client.put(
        f"/v1/ml/no-show/predictions/{actionable['id']}/intervention",
        headers=tenant_headers(org_b, mutate=True),
        json={"channel": "phone", "contact_result": "confirmed"},
    )
    assert forbidden.status_code == 404

    listed = client.get("/v1/ml/no-show/predictions", headers=tenant_headers(org_a))
    item = next(x for x in listed.json() if x["id"] == actionable["id"])
    assert item["intervention"]["channel"] == "phone"
    assert item["intervention"]["contact_result"] == "confirmed"

    summary = client.get("/v1/ml/no-show/measure-summary", headers=tenant_headers(org_a))
    assert summary.status_code == 200
    assert summary.json()["executed_actions"] >= 1


def test_opportunity_decision_is_separate_from_measurement() -> None:
    org_id = create_tenant("Opportunity Decision Tenant")
    sample = Path("datasets/sample/operations.json").read_bytes()
    upload = client.post(
        "/v1/datasets",
        headers=tenant_headers(org_id, mutate=True),
        files={"file": ("operations.json", sample, "application/json")},
    )
    assert upload.status_code == 201, upload.text
    dataset_id = upload.json()["id"]
    analyzed = client.post(
        f"/v1/datasets/{dataset_id}/analyze",
        headers=tenant_headers(org_id, mutate=True),
    )
    assert analyzed.status_code == 200, analyzed.text

    open_items = client.get(
        "/v1/opportunities?status=open", headers=tenant_headers(org_id)
    )
    assert open_items.status_code == 200, open_items.text
    opportunity_id = open_items.json()[0]["id"]

    accepted = client.post(
        f"/v1/opportunities/{opportunity_id}/decision",
        headers=tenant_headers(org_id, mutate=True),
        json={"decision": "accepted", "notes": "Executar piloto por quatro semanas."},
    )
    assert accepted.status_code == 200, accepted.text
    assert accepted.json()["status"] == "accepted"
    assert accepted.json()["decision_note"] == "Executar piloto por quatro semanas."
    assert accepted.json()["decided_at"] is not None

    open_after = client.get(
        "/v1/opportunities?status=open", headers=tenant_headers(org_id)
    ).json()
    assert all(item["id"] != opportunity_id for item in open_after)
    tracking = client.get(
        "/v1/opportunities?status=accepted", headers=tenant_headers(org_id)
    )
    assert tracking.status_code == 200
    assert any(item["id"] == opportunity_id for item in tracking.json())

    detail = client.get(
        f"/v1/opportunities/{opportunity_id}", headers=tenant_headers(org_id)
    )
    assert detail.status_code == 200
    assert detail.json()["status"] == "accepted"

    measured = client.post(
        f"/v1/opportunities/{opportunity_id}/outcome",
        headers=tenant_headers(org_id, mutate=True),
        json={"measured_gain": 1234.5, "notes": "Ganho observado no piloto."},
    )
    assert measured.status_code == 201, measured.text
    detail_after = client.get(
        f"/v1/opportunities/{opportunity_id}", headers=tenant_headers(org_id)
    )
    assert detail_after.json()["status"] == "measured"


def test_dismissed_opportunity_cannot_be_measured() -> None:
    org_id = create_tenant("Dismissed Opportunity Tenant")
    sample = Path("datasets/sample/operations.json").read_bytes()
    upload = client.post(
        "/v1/datasets",
        headers=tenant_headers(org_id, mutate=True),
        files={"file": ("operations.json", sample, "application/json")},
    )
    dataset_id = upload.json()["id"]
    client.post(
        f"/v1/datasets/{dataset_id}/analyze",
        headers=tenant_headers(org_id, mutate=True),
    )
    opportunity_id = client.get(
        "/v1/opportunities?status=open", headers=tenant_headers(org_id)
    ).json()[0]["id"]
    dismissed = client.post(
        f"/v1/opportunities/{opportunity_id}/decision",
        headers=tenant_headers(org_id, mutate=True),
        json={"decision": "dismissed", "notes": "Fora de escopo neste ciclo."},
    )
    assert dismissed.status_code == 200
    assert dismissed.json()["status"] == "dismissed"
    outcome = client.post(
        f"/v1/opportunities/{opportunity_id}/outcome",
        headers=tenant_headers(org_id, mutate=True),
        json={"measured_gain": 10},
    )
    assert outcome.status_code == 422


def test_opportunity_analytics_tracks_decisions_and_measured_gain() -> None:
    org_id = create_tenant("Opportunity Analytics Tenant")
    sample = Path("datasets/sample/operations.json").read_bytes()
    upload = client.post(
        "/v1/datasets",
        headers=tenant_headers(org_id, mutate=True),
        files={"file": ("operations.json", sample, "application/json")},
    )
    dataset_id = upload.json()["id"]
    analyzed = client.post(
        f"/v1/datasets/{dataset_id}/analyze",
        headers=tenant_headers(org_id, mutate=True),
    )
    assert analyzed.status_code == 200
    opportunities = client.get(
        "/v1/opportunities?status=open", headers=tenant_headers(org_id)
    ).json()
    assert len(opportunities) >= 2

    measured_id = opportunities[0]["id"]
    dismissed_id = opportunities[1]["id"]
    accepted = client.post(
        f"/v1/opportunities/{measured_id}/decision",
        headers=tenant_headers(org_id, mutate=True),
        json={"decision": "accepted"},
    )
    assert accepted.status_code == 200
    outcome = client.post(
        f"/v1/opportunities/{measured_id}/outcome",
        headers=tenant_headers(org_id, mutate=True),
        json={"measured_gain": 500.0, "notes": "Resultado validado."},
    )
    assert outcome.status_code == 201
    dismissed = client.post(
        f"/v1/opportunities/{dismissed_id}/decision",
        headers=tenant_headers(org_id, mutate=True),
        json={"decision": "dismissed"},
    )
    assert dismissed.status_code == 200

    analytics = client.get(
        "/v1/opportunities/analytics", headers=tenant_headers(org_id)
    )
    assert analytics.status_code == 200, analytics.text
    payload = analytics.json()
    assert payload["measured_opportunities"] == 1
    assert payload["dismissed_opportunities"] == 1
    assert payload["measured_gain"] == 500.0
    assert payload["successful_opportunities"] == 1
    assert payload["adoption_rate"] == 0.5
    assert payload["success_rate"] == 1.0
    assert payload["by_category"]
    assert payload["by_equipment"]

    measured = client.get(
        "/v1/opportunities?status=measured", headers=tenant_headers(org_id)
    )
    assert measured.status_code == 200
    item = next(item for item in measured.json() if item["id"] == measured_id)
    assert item["measured_gain"] == 500.0
    assert item["outcome_notes"] == "Resultado validado."
    assert item["outcome_recorded_at"] is not None


def test_opportunity_decision_impact_links_decision_future_snapshot_and_outcome() -> None:
    org_id = create_tenant("Decision Impact Tenant")
    base = Path("datasets/csv-sample")

    def upload(appointments_bytes: bytes) -> str:
        response = client.post(
            "/v1/datasets/csv-bundle",
            headers=tenant_headers(org_id, mutate=True),
            files={
                "equipment": ("equipment.csv", (base / "equipment.csv").read_bytes(), "text/csv"),
                "availability": ("availability.csv", (base / "availability.csv").read_bytes(), "text/csv"),
                "appointments": ("appointments.csv", appointments_bytes, "text/csv"),
                "executions": ("executions.csv", (base / "executions.csv").read_bytes(), "text/csv"),
            },
        )
        assert response.status_code == 201, response.text
        return response.json()["dataset"]["id"]

    original = (base / "appointments.csv").read_bytes()
    first_id = upload(original)
    assert client.post(
        f"/v1/datasets/{first_id}/analyze",
        headers=tenant_headers(org_id, mutate=True),
    ).status_code == 200

    opportunities = client.get(
        "/v1/opportunities?status=open", headers=tenant_headers(org_id)
    ).json()
    cancellation = next(item for item in opportunities if item["category"] == "cancellation")

    decision = client.post(
        f"/v1/opportunities/{cancellation['id']}/decision",
        headers=tenant_headers(org_id, mutate=True),
        json={"decision": "accepted", "notes": "Pilot intervention"},
    )
    assert decision.status_code == 200, decision.text

    before = client.get(
        f"/v1/opportunities/{cancellation['id']}/history",
        headers=tenant_headers(org_id),
    ).json()["decision_impact"]
    assert before["state"] == "awaiting_post_decision_data"
    assert before["snapshots_before_decision"] == 1
    assert before["snapshots_after_decision"] == 0
    assert before["decision_note"] == "Pilot intervention"

    changed = original.decode().replace(
        "a2,rm-02,MRI_BRAIN,2026-08-20T09:00:00,60,cancelled,3000",
        "a2,rm-02,MRI_BRAIN,2026-08-20T09:00:00,60,cancelled,4200",
    ).encode()
    second_id = upload(changed)
    assert client.post(
        f"/v1/datasets/{second_id}/analyze",
        headers=tenant_headers(org_id, mutate=True),
    ).status_code == 200

    after_payload = client.get(
        f"/v1/opportunities/{cancellation['id']}/history",
        headers=tenant_headers(org_id),
    ).json()["decision_impact"]
    assert after_payload["state"] == "post_decision_observed"
    assert after_payload["snapshots_after_decision"] == 1
    assert after_payload["baseline_before_decision"] is not None
    assert after_payload["current_after_decision"] is not None

    measured = client.post(
        f"/v1/opportunities/{cancellation['id']}/outcome",
        headers=tenant_headers(org_id, mutate=True),
        json={"measured_gain": 500.0, "notes": "Observed pilot result"},
    )
    assert measured.status_code == 201, measured.text

    final = client.get(
        f"/v1/opportunities/{cancellation['id']}/history",
        headers=tenant_headers(org_id),
    ).json()["decision_impact"]
    assert final["measured_gain"] == 500.0
    assert final["outcome_notes"] == "Observed pilot result"
    assert final["potential_at_outcome"] is not None
    assert final["realization_rate"] is not None


def test_executive_summary_is_tenant_scoped_and_composes_existing_metrics() -> None:
    org_id = create_tenant("Executive Diagnosticos")
    base = Path("datasets/csv-sample")
    files = {
        "equipment": ("equipment.csv", (base / "equipment.csv").read_bytes(), "text/csv"),
        "availability": ("availability.csv", (base / "availability.csv").read_bytes(), "text/csv"),
        "appointments": ("appointments.csv", (base / "appointments.csv").read_bytes(), "text/csv"),
        "executions": ("executions.csv", (base / "executions.csv").read_bytes(), "text/csv"),
    }
    uploaded = client.post(
        "/v1/datasets/csv-bundle", headers=tenant_headers(org_id, mutate=True), files=files
