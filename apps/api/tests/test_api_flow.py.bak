        db.flush()
        run = ModelRun(
            organization_id=org_id,
            dataset_id=dataset.id,
            model_name="no-show-risk",
            selected_model_version="v",
            feature_set_version="f",
            training_rows=1,
            calibration_rows=1,
            validation_rows=1,
            metrics={},
        )
        db.add(run)
        db.flush()
        pred = NoShowPrediction(
            organization_id=org_id,
            dataset_id=dataset.id,
            model_run_id=run.id,
            appointment_id="measure-financial-appointment",
            equipment_id="rm",
            scheduled_at=datetime.now(timezone.utc) - timedelta(hours=1),
            probability=0.5,
            expected_revenue=1000,
            expected_loss=500,
            expected_recovered_revenue=300,
            expected_net_value=290,
            action_recommended=True,
            recommended_action_type="request_confirmation",
            recommended_action_label="Solicitar confirmação",
            recommendation_reason="x",
            risk_level="moderate",
            model_version="v",
            feature_set_version="f",
            evidence={},
        )
        db.add(pred)
        db.commit()
        pid = pred.id

    accepted = client.post(
        f"/v1/ml/no-show/predictions/{pid}/decision",
